{
  "manifest_version": 2,
  "name": "Buleku Manchu Lookup",
  "version": "0.1.0",
  "description": "Look up selected Manchu words from Firefox, including PDF selections, in Buleku.",
  "permissions": [
    "contextMenus",
    "tabs",
    "storage",
    "https://buleku.org/*",
    "https://www.buleku.org/*"
  ],
  "background": {
    "scripts": [
      "transliterate.js",
      "background.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "buleku-manchu-lookup@example.local"
    }
  }
}
